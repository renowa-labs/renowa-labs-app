# Brevo SMTP — use credentials generated in Brevo, not your account password.
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_USER=
BREVO_SMTP_PASSWORD=

# CONTACT_FROM_EMAIL must be a sender or domain verified in Brevo.
CONTACT_FROM_EMAIL=website@renowa-labs.com
CONTACT_FROM_NAME=Renowa Labs Website
CONTACT_TO_EMAIL=info@renowa-labs.com

# Optional IndexNow trigger. Use independent, cryptographically random values.
INDEXNOW_KEY=
INDEXNOW_SECRET=
